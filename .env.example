# Optional. The wiki works fully offline from onmyoji_wiki/assets/data, so
# these are only needed to pull newer content with "Đồng bộ lại".
#
# Copy to `.env` and fill in from the Supabase dashboard (Settings → API).
# `.env` is gitignored. You can also type these into the app: the sync button
# prompts for them and stores them in the app's settings.
#
# The anon key is safe on disk — supabase/migrations/0002_rls.sql restricts it
# to SELECT on the wiki tables and nothing else.
#
# If onmyoji_wiki/.env already exists, the app reads it and you can skip this.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
